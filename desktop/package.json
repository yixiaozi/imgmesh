{
  "name": "imgmesh-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "imgmesh for Windows and Mac",
  "author": "imgmesh",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.imgmesh.desktop",
    "productName": "imgmesh",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "dist/**/*",
      "electron/**/*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.photography",
      "target": ["dmg", "zip"],
      "identity": null
    },
    "win": {
      "target": ["nsis", "zip"]
    },
    "linux": {
      "target": ["dir"]
    }
  }
}
