{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "useDefineForClassFields": true
  },
  "include": ["src/main.ts", "src/crypto.ts", "src/api.ts", "src/zip.ts", "vite.config.ts"]
}
